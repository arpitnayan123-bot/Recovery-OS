# Sandbox/dev: SQLite (default)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# PRODUCTION: uncomment and set to your PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/recovery_os
# Then update prisma/schema.prisma datasource provider to "postgresql" and run `bun run db:push`

# Email delivery (Resend) — optional, falls back to console.log in dev
# RESEND_API_KEY=re_xxxxx
# FROM_EMAIL=recovery@recovery-os.in

# Cron secret (protects /api/cron/tick in production)
# CRON_SECRET=your-secret-here
