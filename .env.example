# Prisma database.
# Local dev (sandbox):      file:./db/custom.db  (SQLite — fine locally, NOT on Vercel)
# Vercel / production:      a PostgreSQL connection string, e.g. Neon, Vercel Postgres or Supabase:
# DATABASE_URL="postgresql://user:password@host:5432/recovery_os?sslmode=require"
DATABASE_URL="file:./db/custom.db"

# Email delivery via Resend (optional — falls back to console.log when unset)
# RESEND_API_KEY=re_xxxxxxxx
# FROM_EMAIL=recovery@yourdomain.in

# Protects /api/cron/tick from public calls in production (optional)
# CRON_SECRET=your-secret-here
